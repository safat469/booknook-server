# ---------------------------------------------------------------------------
# BookNook server — environment variables
# Copy to `.env` and fill in.
# ---------------------------------------------------------------------------

# MongoDB connection string (Atlas or local).
MONGODB_URI=

# Database name. Defaults to `booknook`.
MONGODB_DB=booknook

# Shared secret with the Next.js client. The client signs a short-lived JWT
# after a Better Auth login and the API verifies it with this same value.
JWT_SECRET=

# Comma separated list of allowed browser origins. Empty = allow all.
CLIENT_ORIGINS=http://localhost:3000

PORT=5000
